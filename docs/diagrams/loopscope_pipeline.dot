digraph LoopScopePipeline {
  graph [rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.45, ranksep=0.6, fontname="Arial", label="LoopScope analysis pipeline", labelloc=t, fontsize=22];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=14, margin="0.22,0.14"];
  edge [color="#334155", arrowsize=0.8];
  source [label="Program source + integer model", fillcolor="#eff6ff", color="#2563eb"];
  grammar [label="Check restricted grammar\none variable · one guard · one constant update", fillcolor="#f8fafc", color="#475569"];
  unknown [label="UNKNOWN\nUnsupported source form", fillcolor="#fee2e2", color="#dc2626"];
  integer [label="Unbounded-integer proof\nHALTS or LOOPS", fillcolor="#dcfce7", color="#16a34a"];
  finite [label="Optional finite-width model\nHALTS or repeated-state LOOPS", fillcolor="#fef3c7", color="#d97706"];
  source -> grammar;
  grammar -> unknown [label="no match"];
  grammar -> integer [label="match"];
  grammar -> finite [label="separate semantics"];
  {rank=same; unknown; integer; finite;}
}
